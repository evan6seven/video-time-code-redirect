{
  "manifest_version": 3,
  "name": "Video Time Code Redirect",
  "version": "0.1.0",
  "description": "Redirects timestamped links on docs.google.com using a stored source-to-destination mapping.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "video-time-code-redirect@example.local"
    }
  }
}
